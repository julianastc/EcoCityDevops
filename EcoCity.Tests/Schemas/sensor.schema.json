{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SensorIot",
  "type": "object",
  "required": ["tipo", "local", "leitura", "alerta"],
  "properties": {
    "id":      { "type": ["string", "null"] },
    "tipo":    { "type": "string" },
    "local":   { "type": "string" },
    "leitura": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "alerta":  { "type": "string", "enum": ["Normal", "Alerta de Calor", "Esvaziamento Urgente"] }
  }
}
