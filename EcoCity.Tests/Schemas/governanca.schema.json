{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GovernancaAmbiental",
  "type": "object",
  "required": ["empresa", "licenca", "emissaoCarbonoTon", "auditoria", "riscoAmbiental"],
  "properties": {
    "id":                { "type": ["string", "null"] },
    "empresa":           { "type": "string" },
    "licenca":           { "type": "string" },
    "emissaoCarbonoTon": { "type": "integer" },
    "auditoria":         { "type": "string" },
    "riscoAmbiental":    { "type": "string", "enum": ["Adequado", "Atenção", "Risco Alto"] }
  }
}
